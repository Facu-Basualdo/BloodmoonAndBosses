{
	"schemaVersion": 1,
	"id": "bloodmoonandbosses",
	"version": "${version}",
	"name": "Bloodmoon & Bosses",
	"description": "Hostile mobs spawn with levels: the farther from spawn and the older the world, the stronger they are and the better their loot. With affixed champions, stampedes, blood moons and zone bosses. Server-side: vanilla clients can join.",
	"authors": [
		"FacuBas"
	],
	"contact": {
		"homepage": "https://github.com/Facu-Basualdo/BloodmoonAndBosses",
		"sources": "https://github.com/Facu-Basualdo/BloodmoonAndBosses",
		"issues": "https://github.com/Facu-Basualdo/BloodmoonAndBosses/issues"
	},
	"license": "MIT",
	"icon": "assets/bloodmoonandbosses/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.bloodmoonandbosses.BloodmoonAndBosses"
		],
		"client": [
			"com.bloodmoonandbosses.client.BloodmoonAndBossesCliente"
		],
		"jade": [
			"com.bloodmoonandbosses.compat.jade.PluginJade"
		],
		"modmenu": [
			"com.bloodmoonandbosses.client.IntegracionConModMenu"
		]
	},
	"mixins": [
		"bloodmoonandbosses.mixins.json",
		{
			"config": "bloodmoonandbosses.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "bloodmoonandbosses.jade.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"jade": "*"
	}
}
